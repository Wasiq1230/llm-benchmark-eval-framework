# Copy to .env, fill in, then:  set -a && source .env && set +a
# .env is gitignored. Never paste a key into config.yaml or a screenshot.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Only needed if you set gateway.enabled: true in config/config.yaml
GATEWAY_API_KEY=

# Printed into results.json so a report can be traced back to whoever ran it
OPERATOR_NAME=Fatima Naseer
